<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <ImageView
                android:id="@+id/avatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_avatar"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:contentDescription="CR"
                android:src="@mipmap/ic_launcher"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CR"
                    android:textColor="@color/cr_text"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="دستیار صوتی فارسی"
                    android:textColor="@color/cr_text_dim"
                    android:textSize="13sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/stateChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="آماده"
                android:textColor="@color/cr_accent"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/speechText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="سلام! من CR هستم. چطور می‌تونم کمکت کنم؟"
                android:textColor="@color/cr_text"
                android:textSize="18sp"
                android:lineSpacingExtra="4dp"/>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="برای شروع، میکروفون رو بزن یا گوش‌دادن ۲۴ ساعته رو فعال کن."
                android:textColor="@color/cr_text_dim"
                android:textSize="13sp"
                android:layout_marginTop="10dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnTalk"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_primary"
            android:text="🎤  صحبت کن"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnService"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:text="👂  شنیدن ۲۴ ساعته"
                android:textColor="@color/cr_text"
                android:textSize="14sp"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnCheck"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_secondary"
                android:text="🔎  بررسی نصب"
                android:textColor="@color/cr_text"
                android:textSize="14sp"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnAccess"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:text="♿  سرویس دسترسی"
                android:textColor="@color/cr_text"
                android:textSize="14sp"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnHelp"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_secondary"
                android:text="❓  راهنما"
                android:textColor="@color/cr_text"
                android:textSize="14sp"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
